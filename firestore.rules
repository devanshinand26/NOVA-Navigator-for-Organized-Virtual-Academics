rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents: users can only read, create, and update their own profile
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == userId && (request.resource.data.uid == userId || !('uid' in request.resource.data));
      allow update: if request.auth != null && request.auth.uid == userId && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow delete: if false;
    }
  }
}
